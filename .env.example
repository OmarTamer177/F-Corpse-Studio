# ==========================================
# Voltix Studio - Environment Configuration
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=voltix_task
DATABASE_URL=postgresql://postgres:123456@localhost:5432/voltix_task

# Security & Authentication
JWT_SECRET_KEY=change-this-jwt-secret-key-123-voltix-security-key
SECRET_KEY=voltix-session-secret-key-prod-replace

# Backend Runtime
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0

# Frontend Runtime (Optional override)
# VITE_API_URL=http://localhost:5000/api
